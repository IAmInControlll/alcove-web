---
import AlcoveDemo from './AlcoveDemo.tsx';
import Keycap from './Keycap.tsx';
import { demoHotkeys } from '../config/demo';

interface Props {
  downloadHref: string;
  helpHref: string;
}

const { downloadHref, helpHref } = Astro.props;
---

<section class="hm-hero">
  <div class="hm-hero-copy">
    <h1 class="hm-hero-title">Clear the clutter. Keep what matters close.</h1>
    <p class="hm-hero-sub">A visual workspace for Windows, one hotkey away. This one works. Try it.</p>
    <div class="hm-hero-ctas">
      <a class="btn btn-primary" href={downloadHref}>Download for Windows</a>
      <a class="hm-link" href={helpHref}>Get help</a>
    </div>
    <ul class="hm-hero-keys">
      <li>
        <button type="button" class="hm-hero-key" data-demo="window">
          <Keycap keys={demoHotkeys.window} /> hides and shows it
        </button>
      </li>
      <li>
        <button type="button" class="hm-hero-key" data-demo="shelf">
          <Keycap keys={demoHotkeys.shelf} /> opens the Shelf
        </button>
      </li>
    </ul>
  </div>
  <AlcoveDemo client:load />
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.hm-hero-key').forEach((btn) => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('alcove-demo', { detail: btn.dataset.demo }));
    });
  });
</script>
