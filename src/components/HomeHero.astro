---
import AlcoveDemo from './AlcoveDemo.tsx';
import Keycap from './Keycap.tsx';
import { demoHotkeys } from '../config/demo';
---

<section class="hm-hero">
  <div class="hm-hero-copy">
    <h1 class="hm-hero-title">Your space inside Windows.</h1>
    <p class="hm-hero-sub">A visual workspace, one hotkey away.</p>
  </div>
  <div class="hm-hero-try">
    <p class="hm-hero-try-label">Try it out:</p>
    <ul class="hm-hero-keys">
      <li>
        <button type="button" class="hm-hero-key" data-demo="window">
          <Keycap keys={demoHotkeys.window} /> <span data-window-label>Hide Alcove</span>
        </button>
      </li>
      <li>
        <button type="button" class="hm-hero-key" data-demo="shelf">
          <Keycap keys={demoHotkeys.shelf} /> <span data-shelf-label>Show the Shelf</span>
        </button>
      </li>
      <li>
        <button type="button" class="hm-hero-key hm-hero-key-plain" data-demo="notch">
          <span data-notch-label>Show the Notch</span>
        </button>
      </li>
      <li>
        <button type="button" class="hm-hero-key" data-demo="peek">
          <Keycap keys={demoHotkeys.peek} /> Peek the selected item
        </button>
      </li>
    </ul>
  </div>
  <AlcoveDemo client:load />
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.hm-hero-key').forEach((btn) => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('alcove-demo', { detail: btn.dataset.demo }));
    });
  });

  const windowLabel = document.querySelector('[data-window-label]');
  window.addEventListener('alcove-demo-open', (e) => {
    if (windowLabel) windowLabel.textContent = (e as CustomEvent<boolean>).detail ? 'Hide Alcove' : 'Show Alcove';
  });

  const shelfLabel = document.querySelector('[data-shelf-label]');
  window.addEventListener('alcove-demo-shelf', (e) => {
    if (shelfLabel) shelfLabel.textContent = (e as CustomEvent<boolean>).detail ? 'Hide the Shelf' : 'Show the Shelf';
  });

  const notchLabel = document.querySelector('[data-notch-label]');
  window.addEventListener('alcove-demo-notch', (e) => {
    if (notchLabel) notchLabel.textContent = (e as CustomEvent<boolean>).detail ? 'Hide the Notch' : 'Show the Notch';
  });
</script>
