---
import { Check } from 'lucide-react';
import DataFolderVisual from './DataFolderVisual.tsx';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const promises = [
  'No account, no sign-in, and no ID that ties the app to you.',
  'No telemetry, no analytics, no crash reports. There is no Alcove server to send them to.',
  'It works offline. Your workspace stays on your PC unless you export a backup.',
  'Back everything up to one <code>.alcove-backup</code> file and restore it whenever.',
];
---

<section class="hm-section hm-privacy" aria-labelledby="privacy">
  <div class="hm-wrap hm-privacy-grid">
    <div>
      <h2 id="privacy" class="hm-h2">Yours, privately</h2>
      <p class="hm-lede">
        Alcove runs on your PC, not in the cloud. Your shortcuts, layout, and settings are plain files in a folder you
        can open yourself.
      </p>
      <ul class="hm-privacy-list">
        {
          promises.map((text) => (
            <li>
              <span class="hm-privacy-check" aria-hidden="true">
                <Check size={14} strokeWidth={3} />
              </span>
              <span set:html={text} />
            </li>
          ))
        }
      </ul>
      <p class="hm-privacy-more">
        Every detail, including exactly what each online feature sends, is in the <a href={`${base}/privacy/`}>Privacy Policy</a>.
      </p>
    </div>
    <figure class="hm-privacy-visual">
      <DataFolderVisual />
    </figure>
  </div>
</section>
