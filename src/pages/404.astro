---
import BaseLayout from '../layouts/BaseLayout.astro';
import glyphUrl from '../assets/brand/glyph.svg?url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => base + (path.startsWith('/') ? path : '/' + path);
---

<BaseLayout title="Page not found - Alcove" description="This page does not exist." noindex bare>
  <section class="notfound">
    <div class="notfound-zone">
      <img class="notfound-glyph" src={glyphUrl} alt="" width="72" height="72" />
      <h1 class="notfound-title">Nothing here</h1>
      <p class="notfound-line">This page moved, or never existed.</p>
      <div class="notfound-links">
        <a class="btn btn-primary" href={withBase('/')}>Go to the home page</a>
        <a class="hm-link" href={withBase('/install/?download')}>Download for Windows</a>
        <a class="hm-link" href={withBase('/help/')}>Help</a>
      </div>
      <p class="notfound-aside">Still cleaner than the Downloads folder.</p>
    </div>
  </section>
</BaseLayout>
