---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const { title, heading, summary, description, updated, toc, autoDownload } = doc.data;
---

<BaseLayout title={title} description={description} heading={heading} summary={summary} updated={updated} toc={toc} slug={doc.id}>
  <Content />
</BaseLayout>

{autoDownload && (
  <script is:inline define:vars={{ downloadUrl: site.downloadUrl }}>
    (function () {
      var params = new URLSearchParams(location.search);
      if (!params.has('download')) return;
      params.delete('download');
      var query = params.toString();
      history.replaceState(null, '', location.pathname + (query ? '?' + query : '') + location.hash);
      function startDownload() {
        try {
          var a = document.createElement('a');
          a.href = downloadUrl;
          a.download = 'Alcove-setup.exe';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          var note = document.querySelector('.install-started');
          if (note) note.hidden = false;
        } catch (e) {}
      }
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        startDownload();
      } else {
        document.addEventListener('DOMContentLoaded', startDownload);
      }
    })();
  </script>
)}
