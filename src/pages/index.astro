---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchIntroInit from '../components/ArchIntroInit.astro';
import ArchIntro from '../components/ArchIntro.astro';
import HomeHero from '../components/HomeHero.astro';
import DemoVideo from '../components/DemoVideo.tsx';
import HomeWorkspace from '../components/HomeWorkspace.astro';
import HomeShelf from '../components/HomeShelf.astro';
import HomeThemes from '../components/HomeThemes.astro';
import ComparisonTable from '../components/ComparisonTable.tsx';
import HomePrivacy from '../components/HomePrivacy.astro';
import SectionHeader from '../components/SectionHeader.tsx';
import FAQAccordion from '../components/FAQAccordion.tsx';
import HomeClosing from '../components/HomeClosing.astro';
import Email from '../components/Email.astro';
import { site } from '../config/site';
import { demo, comparison, faqGroups } from '../config/home';
import { demoVideoUrl, demoPosterUrl } from '../config/video';
import { screenshotUrl } from '../config/screenshots';
import changelogSource from '../content/docs/changelog.md?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => base + (path.startsWith('/') ? path : '/' + path);

const latestVersion = changelogSource.match(/\(v(\d+\.\d+\.\d+)\)/)?.[1];
const absolute = (path: string | undefined) => (path ? new URL(path, site.url).href : undefined);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: site.title,
      url: site.url + '/',
    },
    {
      '@type': 'SoftwareApplication',
      name: site.title,
      description: site.description,
      url: site.url + '/',
      image: site.url + '/og.png',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Windows 10, Windows 11',
      softwareVersion: latestVersion,
      screenshot: [absolute(screenshotUrl('hero-1.webp')), absolute(screenshotUrl('shelf.png'))].filter(Boolean),
      downloadUrl: site.downloadUrl,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@type': 'Person', name: 'IAmInControlll', url: 'https://github.com/IAmInControlll' },
    },
  ],
};
---

<BaseLayout title={site.title} description={site.description} bare>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <ArchIntroInit slot="head" />
  <ArchIntro slot="overlay" />

  <HomeHero downloadHref={withBase('/install/?download')} helpHref={withBase('/help/')} />
  <div class="prose hm-prose">
    <DemoVideo copy={demo} src={demoVideoUrl} poster={demoPosterUrl} />
  </div>
  <HomeWorkspace />
  <HomeShelf />
  <HomeThemes />
  <div class="prose hm-prose">
    <ComparisonTable comparison={comparison} />
  </div>
  <HomePrivacy />
  <div class="prose hm-prose">
    <section class="home-section band" aria-labelledby="questions">
      <SectionHeader id="questions" title="Questions">
        Alcove is built by one person. Questions, bugs, and feature requests all land in the same inbox: <Email email={site.contactEmail} />
      </SectionHeader>
      <FAQAccordion client:visible groups={faqGroups} helpHref={withBase('/help/')} />
    </section>
  </div>
  <HomeClosing downloadHref={withBase('/install/?download')} helpHref={withBase('/help/')} changelogHref={withBase('/changelog/')} />
</BaseLayout>
